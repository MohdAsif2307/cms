# HMS (.env.sample)
# Copy this file to .env and edit values before running in development/production.

# Secret used to sign HMS JWTs
HMS_JWT_SECRET=your_hms_jwt_secret_here

# Secret used to verify CMS transfer tokens (must match CMS CMS_SSO_SECRET)
CMS_SSO_SECRET=your_cms_sso_secret_here

# CMS backend URL (used by HMS to call back to CMS validate-transfer)
CMS_API_URL=http://localhost:4000

# HMS frontend URL (origin) used for CORS and redirect after SSO
HMS_FRONTEND_URL=http://localhost:5173

# MongoDB connection for HMS
MONGO_URI=mongodb://localhost:27017/hms

# Other configuration
PORT=5000
NODE_ENV=development
