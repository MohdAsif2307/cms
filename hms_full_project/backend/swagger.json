{
  "openapi": "3.0.0",
  "info": {
    "title": "HMS Backend API",
    "version": "1.0.0",
    "description": "Minimal OpenAPI spec for HMS backend to test endpoints via Swagger UI"
  },
  "servers": [ { "url": "http://localhost:5000", "description": "Local dev server" } ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register user",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": {"type":"string"}, "email":{"type":"string"}, "password":{"type":"string"}, "role":{"type":"string"} } } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "email":{"type":"string"}, "password":{"type":"string"} } } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/rooms": {
      "post": {
        "summary": "Create room (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "number": {"type":"string"}, "capacity": {"type":"integer"} } } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/notices": {
      "post": {
        "summary": "Create notice (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "title":{"type":"string"}, "body":{"type":"string"} } } } } },
        "responses": { "201": { "description": "Created" } }
      },
      "get": {
        "summary": "List notices",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/complaints": {
      "post": {
        "summary": "Create complaint",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "subject":{"type":"string"}, "description":{"type":"string"} } } } } },
        "responses": { "201": { "description": "Created" } }
      }
    }
  }
}
