MONGODB_URI=mongodb://127.0.0.1:27017/cms
PORT=4000
JWT_SECRET=shared_secret_for_testing
CMS_SSO_SECRET=shared_secret_for_testing
HMS_API_URL=http://localhost:5001
HMS_FRONTEND_URL=http://localhost:5174

# Enable using CMS-hosted mock for HMS SSO accept in local development.
# When set to 1, `/api/sso/redirect` will return a CMS URL pointing to
# `/api/sso/accept-mock` instead of the external HMS URL.
FORCE_LOCAL_SSO_MOCK=0
# Where the dev frontend is served (used by accept-mock to redirect back).
FRONTEND_URL=http://localhost:5173
