# CMS (.env.sample)
# Copy this file to .env and edit values before running in development/production.

# JWT secret used for CMS authentication
JWT_SECRET=your_cms_jwt_secret_here
# Optional explicit name for SSO signing secret (if not set, JWT_SECRET is used)
CMS_SSO_SECRET=your_cms_sso_secret_here

# HMS backend API URL (used by CMS to build redirect URL)
HMS_API_URL=http://localhost:5000

# MongoDB connection for CMS
MONGO_URI=mongodb://localhost:27017/cms

# CMS frontend URL (if needed in responses)
CMS_FRONTEND_URL=http://localhost:4000

# Other configuration
PORT=4000
NODE_ENV=development
